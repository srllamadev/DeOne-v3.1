{
  "name": "stellar-game-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Stellar Game Wallet - Billetera digital gamificada sobre Stellar",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @stellar-game/web dev",
    "dev:api": "pnpm --filter @stellar-game/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @stellar-game/web build",
    "build:api": "pnpm --filter @stellar-game/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @stellar-game/api test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @stellar-game/api db:migrate",
    "db:generate": "pnpm --filter @stellar-game/api db:generate",
    "contracts:build": "cd contracts && stellar contract build",
    "contracts:test": "cd contracts && cargo test",
    "contracts:fmt": "cd contracts && cargo fmt --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
